.player-card {
  width: 33.33%;
  box-sizing: border-box;
  padding: 24rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.player-avatar-wrap {
  position: relative;
}
.player-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.35);
  box-sizing: border-box;
}
.player-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
}
.host-badge {
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  background: var(--gold);
  color: #3a2a08;
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}
.me-badge {
  position: absolute;
  bottom: -8rpx;
  right: -8rpx;
  background: var(--accent);
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}
.player-name {
  margin-top: 8rpx;
  font-size: 26rpx;
  max-width: 148rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.player-score {
  margin-top: 2rpx;
  font-size: 34rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
