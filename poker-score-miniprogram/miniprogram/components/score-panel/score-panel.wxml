<view class="panel-mask" wx:if="{{show}}" bindtap="onClose">
  <view class="panel" catchtap="noop">
    <view class="panel-title">为 {{player.nickname}} 记录积分</view>
    <view class="panel-avatar-row">
      <image wx:if="{{player.avatar}}" class="panel-avatar" src="{{player.avatar}}" mode="aspectFill"></image>
      <view wx:else class="panel-avatar panel-avatar-fallback" style="background: {{player.avatarColor}}">{{player.avatarText}}</view>
    </view>

    <view class="preset-row">
      <view class="preset-chip plus {{selected === item && !customMode ? 'active' : ''}}" wx:for="{{presetPlus}}" wx:key="*this" data-value="{{item}}" bindtap="selectPreset">+{{item}}</view>
    </view>

    <view class="custom-row">
      <input class="input custom-input" type="number" placeholder="自定义加分" value="{{custom}}" bindinput="onCustomInput"></input>
    </view>

    <view class="current-delta pos">+{{effective}} 积分</view>
    <view class="panel-rate-tip">当前倍率 ×{{rate}}，记录为实际积分</view>

    <view class="panel-actions">
      <button class="btn btn-ghost" bindtap="onClose">取消</button>
      <button class="btn btn-primary" bindtap="onConfirm">确认记录</button>
    </view>
  </view>
</view>
