.settle-page {
  padding-top: 48rpx;
  padding-bottom: 64rpx;
}
.settle-head {
  text-align: center;
  margin-bottom: 32rpx;
}
.settle-title {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}
.settle-room {
  margin-top: 16rpx;
  font-size: 30rpx;
}
.settle-meta {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
}
.podium {
  padding: 16rpx 32rpx;
  margin-bottom: 40rpx;
}
.podium-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.podium-item:last-child {
  border-bottom: none;
}
.podium-item.first {
  background: rgba(242, 193, 78, 0.08);
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
}
.rank {
  width: 90rpx;
  font-size: 40rpx;
}
.podium-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.podium-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #062018;
}
.podium-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
}
.podium-score {
  font-size: 36rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.pay-tip {
  margin-top: 56rpx;
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
  padding: 0 40rpx;
}
.settle-page .btn {
  margin-top: 20rpx;
}
.transfer-card {
  margin-top: 32rpx;
  margin-bottom: 40rpx;
}
.transfer-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 24rpx;
}
.rate-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}
.rate-label,
.rate-unit {
  font-size: 30rpx;
  color: var(--muted);
}
.rate-label { margin-right: 16rpx; }
.rate-unit { margin-left: 16rpx; }
.rate-input {
  width: 180rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  height: 80rpx;
  padding: 0 24rpx;
  color: var(--text);
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  box-sizing: border-box;
}
.transfer-empty {
  font-size: 28rpx;
  color: var(--muted);
  text-align: center;
  padding: 24rpx 0;
}
.transfer-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.transfer-item:last-child {
  border-bottom: none;
}
.transfer-name {
  font-size: 30rpx;
  font-weight: 600;
  max-width: 200rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.transfer-from { color: var(--danger); }  /* 欠款方：红 */
.transfer-to   { color: var(--accent); }  /* 收款方：绿 */
.transfer-arrow {
  margin: 0 16rpx;
  color: var(--muted);
}
.transfer-amount {
  flex: 1;
  text-align: right;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--gold);
  font-variant-numeric: tabular-nums;
}
.transfer-copy {
  margin-top: 28rpx;
}
