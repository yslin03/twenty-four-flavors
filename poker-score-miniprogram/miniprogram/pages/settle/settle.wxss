.settle-page {
  padding-top: 48rpx;
  padding-bottom: 64rpx;
}
.settle-head {
  text-align: center;
  margin-bottom: 32rpx;
}
.settle-title {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}
.settle-room {
  margin-top: 16rpx;
  font-size: 30rpx;
}
.settle-meta {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
}
.podium {
  padding: 16rpx 32rpx;
  margin-bottom: 40rpx;
}
.podium-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.podium-item:last-child {
  border-bottom: none;
}
.podium-item.first {
  background: rgba(242, 193, 78, 0.08);
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
}
.rank {
  width: 90rpx;
  font-size: 40rpx;
}
.podium-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.podium-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #062018;
}
.podium-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
}
.podium-score {
  font-size: 36rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.pay-tip {
  margin-top: 56rpx;
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
  padding: 0 40rpx;
}
.settle-page .btn {
  margin-top: 20rpx;
}
