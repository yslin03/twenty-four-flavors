.settle-page {
  position: relative;
  padding-top: 48rpx;
  padding-bottom: 64rpx;
}
.settle-head {
  text-align: center;
  margin-bottom: 32rpx;
}
.settle-title {
  font-size: 58rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
}
.settle-room {
  margin-top: 16rpx;
  font-size: 30rpx;
}
.settle-meta {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
}
.virtual-badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 24rpx;
  font-size: 22rpx;
  color: var(--accent);
  background: rgba(53, 201, 142, 0.14);
  border: none;
  border-radius: 999rpx;
}
.podium {
  padding: 16rpx 32rpx;
  margin-bottom: 40rpx;
}
.podium-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.podium-item:last-child {
  border-bottom: none;
}
.podium-item.first {
  background: rgba(242, 193, 78, 0.12);
  border-radius: 20rpx;
  padding: 20rpx 16rpx;
}
.rank {
  width: 90rpx;
  font-size: 40rpx;
}
.podium-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.podium-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #062018;
}
.podium-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
}
.podium-score {
  font-size: 36rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.pay-tip {
  margin-top: 56rpx;
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
  padding: 0 40rpx;
}
.settle-page .btn {
  margin-top: 20rpx;
}
.stats {
  margin-bottom: 24rpx;
}
.stats-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.stats-item:last-child {
  border-bottom: none;
}
.stats-name {
  font-size: 30rpx;
  font-weight: 600;
}
.stats-meta {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 6rpx;
}
.stats-total {
  font-size: 36rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.stats-rank {
  display: inline-block;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--accent);
  background: rgba(53, 201, 142, 0.14);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  vertical-align: middle;
}
.history-btn {
  margin-top: 24rpx;
}
.history-modal {
  width: 640rpx;
}
.history-scroll {
  max-height: 60vh;
}
.history-game {
  background: var(--surface-2);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.history-game-head {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 10rpx;
}
.history-game-row {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  padding: 6rpx 0;
}
.history-game-rank {
  width: 110rpx;
  color: var(--muted);
  font-size: 24rpx;
}
.history-game-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.history-game-score {
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.history-empty {
  text-align: center;
  padding: 40rpx 0;
}
