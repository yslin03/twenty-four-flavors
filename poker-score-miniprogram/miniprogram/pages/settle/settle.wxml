<view class="container settle-page">
  <view class="settle-head">
    <view class="settle-title">结算</view>
    <view class="settle-room">{{room.name}}</view>
    <view class="settle-meta">房间码 {{room.code}} · 共 {{playerList.length}} 人 · {{room.status === 'ended' ? '本局已结束' : '进行中预览'}}</view>
  </view>

  <view class="card podium">
    <view class="podium-item {{index === 0 ? 'first' : ''}}" wx:for="{{playerList}}" wx:key="id">
      <view class="rank">{{item.rankText}}</view>
      <view class="podium-avatar-wrap">
        <image wx:if="{{item.avatar}}" class="podium-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
        <view wx:else class="podium-avatar podium-avatar-fallback" style="background: {{item.avatarColor}}">{{item.avatarText}}</view>
      </view>
      <view class="podium-name">{{item.nickname}}</view>
      <view class="podium-score {{item.score >= 0 ? 'pos' : 'neg'}}">{{item.score >= 0 ? '+' : ''}}{{item.score}}</view>
    </view>
  </view>

  <view class="card transfer-card">
    <view class="transfer-title">优化转账清单</view>

    <view class="rate-row">
      <text class="rate-label">1 分 =</text>
      <input class="rate-input" type="digit" value="{{rate}}" bindinput="onRateInput" bindblur="onRateBlur" placeholder="1" />
      <text class="rate-unit">元</text>
    </view>

    <view class="transfer-empty" wx:if="{{!transfers.length}}">无需转账，已全部结清</view>

    <view class="transfer-item" wx:for="{{transfers}}" wx:key="key">
      <view class="transfer-name transfer-from">{{item.fromName}}</view>
      <view class="transfer-arrow">→</view>
      <view class="transfer-name transfer-to">{{item.toName}}</view>
      <view class="transfer-amount">{{item.amountText}}</view>
    </view>

    <button class="btn btn-primary btn-block transfer-copy" bindtap="onCopyTransfer">复制转账清单</button>
  </view>

  <button class="btn btn-ghost btn-block" bindtap="onCopy">复制结算文案</button>
  <button class="btn btn-ghost btn-block" bindtap="onRestart">再来一局</button>
  <button class="btn btn-ghost btn-block" bindtap="onHome">返回首页</button>

  <view class="pay-tip">结算提示：本小程序仅记录分数。按「1 分 = X 元」生成优化转账清单，请通过微信「收付款 / 转账」完成以上款项。</view>
</view>
