.hero {
  padding: 52rpx 12rpx 46rpx;
  text-align: left;
}
.index-page { position: relative; }
.hero-badge {
  font-size: 26rpx;
  color: var(--accent);
  letter-spacing: 0;
  opacity: 0.9;
  margin-bottom: 20rpx;
}
.hero-title {
  font-size: 62rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
}
.hero-sub {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: var(--muted);
}
.actions {
  display: flex;
  flex-direction: column;
}
.join-row {
  display: flex;
  margin-top: 24rpx;
}
.join-input {
  flex: 1;
}
.join-btn {
  width: 200rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-left: 20rpx;
  background: var(--accent);
  color: #062018;
  border: none;
  border-radius: 20rpx;
  font-weight: 600;
}
.demo-btn {
  margin-top: 24rpx;
}
.scan-btn {
  margin-top: 24rpx;
  background: var(--surface-2);
  color: var(--accent);
  border: 1rpx solid rgba(53, 201, 142, 0.45);
  border-radius: 20rpx;
  font-weight: 600;
}
.career {
  margin-top: 24rpx;
}
.career-row {
  display: flex;
}
.career-item {
  flex: 1;
  text-align: center;
}
.career-num {
  font-size: 40rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.career-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--muted);
}
.career-rank {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--accent);
  text-align: center;
}
.version-footer {
  margin-top: 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  opacity: 0.7;
}
