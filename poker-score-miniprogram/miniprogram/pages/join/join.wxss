.page-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
}
.room-summary {
  background: var(--surface-2);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}
.room-summary-name {
  font-size: 32rpx;
  font-weight: 600;
}
.room-summary-meta {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
}
.code-input {
  letter-spacing: 6rpx;
  font-weight: 700;
  color: var(--gold);
}
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 8rpx 0 32rpx;
}
.picker-value {
  background: var(--surface-2);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
}
.avatar-row {
  display: flex;
  align-items: center;
}
.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  padding: 0;
  margin: 0;
  background: var(--surface-2);
  border: 1rpx solid var(--border);
  line-height: 1;
}
.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}
.avatar-fallback {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #062018;
  box-sizing: border-box;
}
.avatar-tip {
  font-size: 24rpx;
  color: var(--muted);
  margin-left: 24rpx;
}
.submit-btn {
  margin-top: 40rpx;
}
