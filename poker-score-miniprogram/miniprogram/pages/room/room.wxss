.room-page {
  position: relative;
  min-height: 100vh;
  background: var(--bg);
}
.room-page.is-dark {
  --bg: #101114;
  --surface: #1c1c1e;
  --surface-2: #2c2c2e;
  --accent: #0a84ff;
  --gold: #ffd60a;
  --danger: #ff453a;
  --muted: #a1a1aa;
  --text: #f5f5f7;
  --border: rgba(255, 255, 255, 0.14);
  color: var(--text);
}
.room-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 32rpx 32rpx 18rpx;
}
.room-header-info {
  min-width: 0;
  flex: 1;
}
.room-name {
  font-size: 46rpx;
  font-weight: 700;
}
.room-meta {
  font-size: 32rpx;
  line-height: 1.45;
  color: var(--muted);
  margin-top: 10rpx;
}
.mini-btn {
  background: var(--accent);
  color: #fff;
  border-radius: 999rpx;
  flex: none;
  font-size: 30rpx;
  padding: 0 38rpx;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0;
}
.rate-row {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  padding: 14rpx 32rpx 12rpx;
  gap: 12rpx;
}
.rate-label {
  font-size: 30rpx;
  line-height: 68rpx;
  color: var(--muted);
  margin-right: 6rpx;
}
.rate-chip {
  min-width: 88rpx;
  text-align: center;
  margin: 0;
  padding: 14rpx 4rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 1.2;
  color: var(--text);
  background: var(--surface-2);
  border: none;
}
.rate-chip.active {
  color: #fff;
  background: var(--accent);
  border-color: var(--accent);
  font-weight: 700;
}
.rate-custom-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 32rpx 8rpx;
}
.rate-input {
  width: 320rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0 16rpx 0 0;
  background: var(--surface);
  box-sizing: border-box;
}
.rate-confirm {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 36rpx;
}
.table {
  padding: 30rpx 24rpx 20rpx;
}
.table-felt {
  position: relative;
  box-sizing: border-box;
  background: radial-gradient(circle at 50% 40%, #1d4a38 0%, #123527 60%, #0e2a1f 100%);
  border: 10rpx solid #2a1c10;
  border-radius: 32rpx;
  padding: 32rpx 20rpx 16rpx;
  box-shadow: inset 0 0 44rpx rgba(0, 0, 0, 0.35), 0 10rpx 28rpx rgba(0, 0, 0, 0.28);
}
.theme-dark .table-felt {
  background: radial-gradient(circle at 50% 40%, #245f49 0%, #174331 60%, #102f23 100%);
  border-color: #3a3a3c;
  box-shadow: inset 0 0 44rpx rgba(0, 0, 0, 0.28), 0 10rpx 28rpx rgba(0, 0, 0, 0.28);
}
.table-label {
  position: absolute;
  top: 18rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 8rpx;
}
.player-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}
.table-tip {
  text-align: center;
  font-size: 28rpx;
  line-height: 1.35;
  color: var(--muted);
  padding: 22rpx 16rpx 6rpx;
}
.toolbar {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  padding: 26rpx 32rpx;
}
.tool-btn {
  margin: 0;
  background: var(--surface);
  color: var(--accent);
  border: none;
  border-radius: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}
.tool-danger { color: var(--danger); background: rgba(224, 79, 79, 0.16); }
.theme-dark .tool-danger { background: rgba(255, 69, 58, 0.16); }
.history-preview {
  padding: 0 32rpx 48rpx;
}
.history-item {
  font-size: 32rpx;
  color: var(--muted);
  padding: 8rpx 0;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.history-time {
  flex: none;
  font-size: 30rpx;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}
.invite-code-label {
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
}
.invite-code {
  font-size: 72rpx;
  font-weight: 800;
  letter-spacing: 12rpx;
  color: var(--gold);
  text-align: center;
  margin: 12rpx 0 28rpx;
}
.qr-wrap {
  margin: 28rpx 0 0;
  text-align: center;
}
.qr-img {
  width: 400rpx;
  height: 400rpx;
}
.qr-tip {
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
  margin: 24rpx 0;
}
.qr-loading {
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
  margin: 24rpx 0;
}
.qr-canvas {
  display: block;
  width: 220px;
  height: 220px;
  margin: 28rpx auto 0;
}
.close-btn {
  margin-top: 20rpx;
}
.nickname-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 32rpx;
}
.nickname-actions .btn {
  width: 240rpx;
  margin: 0;
}
