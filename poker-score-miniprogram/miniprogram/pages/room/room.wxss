.room-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0c1a14 0%, #0f1f19 40%, #10241c 100%);
}
.room-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 8rpx;
}
.room-name {
  font-size: 36rpx;
  font-weight: 700;
}
.room-meta {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 6rpx;
}
.mini-btn {
  background: var(--accent);
  color: #062018;
  border-radius: 999rpx;
  font-size: 26rpx;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
}
.table {
  padding: 24rpx 24rpx 0;
}
.table-felt {
  background: radial-gradient(circle at 50% 40%, #1d4a38 0%, #123527 60%, #0e2a1f 100%);
  border: 12rpx solid #2a1c10;
  border-radius: 40rpx;
  padding: 44rpx 24rpx 28rpx;
  box-shadow: inset 0 0 60rpx rgba(0, 0, 0, 0.35);
  position: relative;
}
.table-label {
  position: absolute;
  top: 18rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 8rpx;
}
.player-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}
.table-tip {
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  padding-top: 12rpx;
}
.toolbar {
  display: flex;
  padding: 28rpx 32rpx;
}
.tool-btn {
  flex: 1;
  margin: 0 8rpx;
  background: var(--surface);
  color: var(--text);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
}
.tool-btn:first-child {
  margin-left: 0;
}
.tool-btn:last-child {
  margin-right: 0;
}
.tool-danger {
  color: var(--danger);
  border-color: rgba(224, 79, 79, 0.4);
}
.history-preview {
  padding: 0 32rpx 48rpx;
}
.history-item {
  font-size: 24rpx;
  color: var(--muted);
  padding: 8rpx 0;
}
.invite-code-label {
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
}
.invite-code {
  font-size: 72rpx;
  font-weight: 800;
  letter-spacing: 12rpx;
  color: var(--gold);
  text-align: center;
  margin: 12rpx 0 28rpx;
}
.qr-wrap {
  margin: 28rpx 0 0;
  text-align: center;
}
.qr-img {
  width: 400rpx;
  height: 400rpx;
}
.qr-tip {
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
  margin: 24rpx 0;
}
.qr-loading {
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
  margin: 24rpx 0;
}
.close-btn {
  margin-top: 20rpx;
}
