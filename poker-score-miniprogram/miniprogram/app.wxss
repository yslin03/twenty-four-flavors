page {
  --bg: #0f1f19;
  --surface: #173029;
  --surface-2: #1e3a31;
  --accent: #35c98e;
  --gold: #f2c14e;
  --danger: #e04f4f;
  --muted: #8fa89d;
  --text: #eaf2ee;
  --border: rgba(255, 255, 255, 0.08);

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
}

.container {
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: var(--surface);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid var(--border);
}

.section-title {
  font-size: 26rpx;
  color: var(--muted);
  margin: 40rpx 4rpx 20rpx;
  letter-spacing: 2rpx;
}

.muted { color: var(--muted); }

/* 按钮 */
button { font-size: 30rpx; }
button::after { border: none; }
.btn {
  border-radius: 16rpx;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0 32rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}
.btn-block { width: 100%; }
.btn-primary { background: var(--accent); color: #062018; }
.btn-primary[disabled] { opacity: 0.5; }
.btn-ghost { background: transparent; color: var(--text); border: 1rpx solid var(--border); }
.btn-danger { background: transparent; color: var(--danger); border: 1rpx solid rgba(224, 79, 79, 0.4); }

/* 输入框 */
.input {
  background: var(--surface-2);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  height: 88rpx;
  padding: 0 24rpx;
  color: var(--text);
  box-sizing: border-box;
  width: 100%;
}
.label {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 14rpx;
}
.field { margin-bottom: 28rpx; }

/* 分数正负 */
.pos { color: var(--accent); }
.neg { color: var(--danger); }

/* 弹层 */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(4, 12, 9, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal {
  width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: var(--surface);
  border-radius: 28rpx;
  padding: 40rpx;
  box-sizing: border-box;
}
.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  text-align: center;
}
