page {
  --bg: #0f1f19;
  --surface: #173029;
  --surface-2: #1e3a31;
  --accent: #35c98e;
  --gold: #f2c14e;
  --danger: #e04f4f;
  --muted: #8fa89d;
  --text: #eaf2ee;
  --border: rgba(255, 255, 255, 0.08);

  background: var(--bg);
  color: var(--text);
  font-size: 30rpx;
  line-height: 1.45;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
}

.theme-root {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
}

.theme-root.theme-dark {
  --bg: #0b1813;
  --surface: #14281f;
  --surface-2: #1c362b;
  --accent: #2fbf84;
  --gold: #f2c14e;
  --danger: #e04f4f;
  --muted: #7f9c90;
  --text: #eaf2ee;
  --border: rgba(255, 255, 255, 0.1);
}

.container {
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}

.card {
  background: var(--surface);
  border-radius: 28rpx;
  padding: 30rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.28);
}
.theme-dark .card { box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.28); }

.section-title {
  font-size: 28rpx;
  color: var(--muted);
  margin: 44rpx 8rpx 18rpx;
  letter-spacing: 0;
}

.muted { color: var(--muted); }

/* 按钮 */
button { font-size: 32rpx; }
button::after { border: none; }
.btn {
  border-radius: 22rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 32rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}
.btn-block { width: 100%; }
.btn-primary { background: var(--accent); color: #062018; box-shadow: 0 8rpx 18rpx rgba(53, 201, 142, 0.3); }
.btn-primary[disabled] { opacity: 0.5; }
.btn-ghost { background: var(--surface); color: var(--accent); border: none; }
.btn-danger { background: rgba(224, 79, 79, 0.16); color: var(--danger); border: none; }
.theme-dark .btn-ghost { background: var(--surface-2); }
.theme-dark .btn-danger { background: rgba(255, 69, 58, 0.16); }

/* 输入框 */
.input {
  background: var(--surface-2);
  border: none;
  border-radius: 20rpx;
  height: 92rpx;
  padding: 0 24rpx;
  color: var(--text);
  box-sizing: border-box;
  width: 100%;
}
.label {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 14rpx;
}
.field { margin-bottom: 28rpx; }

/* 分数正负 */
.pos { color: var(--accent); }
.neg { color: var(--danger); }

/* 弹层 */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.38);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal {
  width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: var(--surface);
  border-radius: 32rpx;
  padding: 40rpx;
  box-sizing: border-box;
}
.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  text-align: center;
}

/* 全局按压反馈：按下立即变淡并轻微缩小，提升按钮响应手感与系统流畅性 */
.button-hover {
  opacity: 0.75;
  transform: scale(0.97);
  transition: opacity 0.08s ease, transform 0.08s ease;
}
.press-hover {
  opacity: 0.75;
  transform: scale(0.97);
  transition: opacity 0.08s ease, transform 0.08s ease;
}
